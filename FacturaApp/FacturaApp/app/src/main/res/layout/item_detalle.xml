<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp">

    <TextView android:id="@+id/tvItemId" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
    <TextView android:id="@+id/tvItemNombre" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" />
    <TextView android:id="@+id/tvItemCant" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" android:gravity="end" />
    <TextView android:id="@+id/tvItemPrecio" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:gravity="end" />
    <TextView android:id="@+id/tvItemSub" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:gravity="end" />
</LinearLayout>
